{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active C File",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c99",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}